# HOW TO USE THIS FILE
# 1. Make your own private copy named ".env" in this same folder (PowerShell: Copy-Item .env.example .env)
# 2. Open ".env" in Notepad and type your keys after the "=" signs. Save as ".env", not ".env.txt"
# 3. Never paste a key into chat, email, a commit, or any other file. Claude is blocked from reading or writing ".env"
#
# ".env" is private: git ignores it, so it can't be committed by accident.
# NEVER put a key in a name that starts with VITE_ : those are sent to every visitor's browser.
# Keys live on the server only. The browser never sees them.
#
# The email relay password does NOT go here. It goes in "relay.private.json" (also private).

# --- Gemini (coaching text), server only ---
GEMINI_API_KEY=

# --- Tiger Data (database) ---
TIGER_DATA_URL=

# --- Vultr Object Storage (datasets, models, test clips) ---
VULTR_S3_ENDPOINT=
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=

# --- Auth0 (login, added last) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
