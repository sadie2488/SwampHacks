{
  "name": "swamphacks-tooling",
  "private": true,
  "type": "module",
  "description": "Tooling for contracts, CI checks and hooks. The website lives in web/, the server in server/.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "hooks:selftest": "node scripts/hook-selftest.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.64.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "imapflow": "^2.5.2",
    "mailparser": "^3.9.40",
    "nodemailer": "^10.1.2"
  }
}
