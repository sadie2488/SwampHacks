{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.swamphacks.invalid/db-schema.schema.json",
  "title": "db-schema",
  "description": "The shape of the database (Tiger Data / Postgres): songs, analyses, practice sessions and creations, with practice measurements stored as time series (a hypertable). The data file is contracts/db-schema.json. The server (L4) turns it into tables.",
  "x-contract-version": 1,
  "type": "object",
  "required": ["version", "tables"],
  "properties": {
    "version": { "const": 1 },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "columns"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": { "enum": ["table", "hypertable"] },
          "time_column": { "type": "string", "description": "For hypertables: the time column." },
          "description": { "type": "string" },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "type": { "enum": ["text", "integer", "bigint", "double precision", "boolean", "timestamptz", "jsonb", "uuid"] },
                "nullable": { "type": "boolean", "default": false },
                "primary_key": { "type": "boolean" },
                "references": { "type": "string", "description": "table.column" },
                "description": { "type": "string" }
              }
            }
          },
          "indexes": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
        },
        "if": { "properties": { "kind": { "const": "hypertable" } } },
        "then": { "required": ["time_column"] }
      }
    }
  }
}
