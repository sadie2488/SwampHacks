# Caddy: the front door of the site. It gets the HTTPS certificate by itself, serves the website
# files, and passes /api/... to the Python server that listens only on this computer (127.0.0.1:8000).
#
# CHANGE THE DOMAIN: setup.sh copies this file to /etc/caddy/Caddyfile and swaps the placeholder address
# used below for the domain you give it (DOMAIN=yourdomain.com). You do not edit this file by hand on the server.
#
# The website folder below is the same one setup.sh and update.sh build into.

example.com {
	root * /opt/swamphacks/app/web/dist

	encode zstd gzip

	# Security headers.
	# The camera and microphone must stay allowed for this site ("self"), or the Play and Create pages stop working.
	header {
		-Server
		Strict-Transport-Security "max-age=604800"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"

		# REPORT-ONLY on purpose: the browser lists anything this policy WOULD block in its console
		# ("[Report Only] Refused to ...") but blocks nothing. Nobody has tried this policy on a live
		# server yet. After a full walk through the site shows no such lines, rename the header to
		# Content-Security-Policy to enforce it (see deploy/README.md, "Content Security Policy").
		# Why each part is there:
		#  'wasm-unsafe-eval'  MediaPipe (camera hand tracking) runs WebAssembly
		#  'unsafe-eval'       the camera worker runs MediaPipe's helper script with eval
		#  blob:               the audio engine and microphone code load from in-page blobs
		#  cdn.jsdelivr.net, storage.googleapis.com, odml.pa.googleapis.com
		#                      MediaPipe's wasm, the hand and face model files, and its usage log
		#  *.auth0.com         login (the address of your Auth0 tenant)
		#  ws://localhost:*    the TouchDesigner relay on the performer's own laptop
		#  style 'unsafe-inline'  the sheet music drawing sets styles on its elements
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob: data: https://cdn.jsdelivr.net https://storage.googleapis.com https://odml.pa.googleapis.com https://*.auth0.com ws://localhost:* ws://127.0.0.1:*; frame-src https://*.auth0.com; object-src 'none'; base-uri 'self'"
	}

	# The server: song upload, analysis, health, login settings, saving.
	# 60 MB is a little above the server's own 50 MB song limit (see MAX_UPLOAD_BYTES in server/app/config.py),
	# so a too-big song still gets the server's friendly "too big" message instead of a dropped connection.
	handle /api/* {
		request_body {
			max_size 60MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# Built files have a new name whenever they change, so browsers may keep them for a long time.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the website. Any address that is not a real file (for example a page opened
	# after login) falls back to index.html so the single-page app can draw it.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Optional: also answer on www and send people to the plain address. Add a "www" record at GoDaddy first,
# then remove the "#" marks and re-run deploy/setup.sh.
# www.example.com {
# 	redir https://example.com{uri} permanent
# }
